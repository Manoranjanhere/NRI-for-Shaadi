# NRI Shaadi — server env (EC2, Docker Compose with bundled Postgres)
# On the server:  cp .env.production.example .env  &&  nano .env
# docker-compose.yml forces DB_HOST=postgres / DB_SSL=false for the API container.

NODE_ENV=production
PORT=3000
DISABLE_PAID_FEATURES=false

# ─── PostgreSQL (container "postgres", created on first `docker compose up`) ───
# These create the database on first start. Changing them later does NOT rename/re-password
# an existing DB — do that with psql instead.
DB_USERNAME=nrishaadi
DB_PASSWORD=change_me_to_a_long_random_password
DB_NAME=nrishaadi
# Host port bound to 127.0.0.1 only (SSH tunnel access). 5433 avoids clashing with any host Postgres.
DB_HOST_PORT=5433

# ─── API port on the host ───
# 127.0.0.1 = only nginx on this server can reach it (recommended).
# Use API_BIND=0.0.0.0 temporarily to test http://EC2_IP:3000 before nginx/SSL is set up.
API_BIND=127.0.0.1
API_HOST_PORT=3001

# ─── Auth ───
JWT_SECRET=generate_with_openssl_rand_hex_48
JWT_EXPIRES_IN=30d
# OAuth clients from the NRI Shaadi Firebase project's google-services.json (client_type 3 / 1)
GOOGLE_CLIENT_ID=your_nrishaadi_web_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_nrishaadi_android_client_id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.nrishaadi.app

# ─── Firebase Admin (phone OTP verification + push) — one-line service account JSON ───
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=your-nrishaadi-firebase-project-id

# ─── Google Play Billing (Premium ₹300/month, SKU nrishaadi_premium_1m) ───
GOOGLE_PLAY_PACKAGE_NAME=com.nrishaadi.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SKIP_VERIFY=false

# ─── AWS S3 (photos) + Rekognition (selfie verification) ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=nrishaadi-photos

# ─── Email (admin alerts) ───
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── URLs ───
APP_DEEP_LINK=nrishaadi
PRIVACY_URL=https://nri-api.sugarbf.club/api/v1/privacy
TERMS_URL=https://sugarbf.club/terms
SUPPORT_URL=https://sugarbf.club/support
