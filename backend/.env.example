# App
PORT=3000
NODE_ENV=development
DISABLE_PAID_FEATURES=true

# Database
# `docker compose up -d` starts Postgres on 127.0.0.1:5433 (and the API container talks to it directly).
# For `npm run start:dev` on the host, point at that container:
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=nrishaadi
DB_PASSWORD=yourpassword
DB_NAME=nrishaadi
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=30d

# Google Sign-In — OAuth clients from the NRI Shaadi Firebase project's google-services.json
# Web OAuth client (client_type 3) — used for idToken verification; must match frontend google.config.ts
GOOGLE_CLIENT_ID=your_nrishaadi_web_client_id.apps.googleusercontent.com
# Android OAuth client (client_type 1) — optional; also accepted when verifying tokens
GOOGLE_ANDROID_CLIENT_ID=your_nrishaadi_android_client_id.apps.googleusercontent.com

# Apple Sign In (iOS only)
APPLE_CLIENT_ID=com.nrishaadi.app

# Firebase Admin (verify phone OTP tokens + push notifications) — NRI Shaadi Firebase project
# Firebase Console → Project settings → Service accounts → Generate new private key → paste as one line.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=your-nrishaadi-firebase-project-id
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Gmail (Nodemailer)
GMAIL_USER=your.admin@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password_16chars

# App URLs
APP_DEEP_LINK=nrishaadi
WEB_BASE_URL=https://sugarbf.club
ADMIN_WEB_URL=https://sugarbf.club/admin
# Served by Nest at GET /api/v1/privacy (HTML). After deploy use:
# https://api.sugarbf.club/api/v1/privacy
PRIVACY_URL=https://api.sugarbf.club/api/v1/privacy
TERMS_URL=https://sugarbf.club/terms
SUPPORT_URL=https://sugarbf.club/support

# Google Play Billing (required for in-app subscriptions on Android)
GOOGLE_PLAY_PACKAGE_NAME=com.nrishaadi.app
# Service account JSON with Android Publisher API access (same file as Firebase is OK if granted Play Console access)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Dev only: skip Play API verify when DISABLE_PAID_FEATURES=true
GOOGLE_PLAY_SKIP_VERIFY=false

# Stripe (legacy — mobile app uses Google Play)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AWS S3 (photo storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=nrishaadi-photos
