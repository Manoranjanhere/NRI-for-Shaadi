# Use on YOUR LAPTOP to run migrations/seeds/psql against the server's Postgres container.
# Copy to:  backend/.env.production.local   (gitignored — do not commit)
#
# Postgres is bound to 127.0.0.1 on the EC2 box, so open an SSH tunnel first:
#   ssh -i your-key.pem -N -L 5433:127.0.0.1:5433 ubuntu@YOUR_EC2_IP
# then run e.g.  npm run db:ping:prod

NODE_ENV=production
DISABLE_PAID_FEATURES=false

DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=nrishaadi
DB_PASSWORD=same_as_server_env
DB_NAME=nrishaadi
DB_SSL=false
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# Only needed if you also run the API locally against the server DB
JWT_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=nrishaadi-photos
