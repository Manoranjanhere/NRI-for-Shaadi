## Copy to keystore.properties (gitignored) and fill in your NRI Shaadi upload keystore.
##
## Create the keystore once (keep it + passwords safe — you need them for every Play update):
##   keytool -genkeypair -v -storetype PKCS12 -keystore android/app/nrishaadi-upload.keystore \
##     -alias nrishaadi-upload -keyalg RSA -keysize 2048 -validity 10000
##
## Then add its SHA-1 and SHA-256 to Firebase (Project settings → Your apps → com.nrishaadi.app):
##   keytool -list -v -keystore android/app/nrishaadi-upload.keystore -alias nrishaadi-upload
## After the first Play upload, also add the "App signing key" SHA-1 from
## Play Console → Setup → App signing, otherwise Google Sign-In fails on Play installs.

storeFile=nrishaadi-upload.keystore
storePassword=your_store_password
keyAlias=nrishaadi-upload
keyPassword=your_key_password
